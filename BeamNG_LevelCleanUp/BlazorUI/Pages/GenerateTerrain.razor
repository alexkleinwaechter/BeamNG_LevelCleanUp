@using DialogResult = System.Windows.Forms.DialogResult
@page "/GenerateTerrain"
@implements IDisposable
@using System.Diagnostics.CodeAnalysis
@using BeamNG_LevelCleanUp.BlazorUI.Components
@using BeamNG_LevelCleanUp.Communication
@using BeamNG_LevelCleanUp.Logic
@using BeamNG_LevelCleanUp.Objects
@using BeamNG_LevelCleanUp.BlazorUI.Services
@using BeamNG_LevelCleanUp.Utils
@using BeamNgTerrainPoc.Terrain
@using BeamNgTerrainPoc.Terrain.Models
@using BeamNgTerrainPoc.Terrain.Osm.Models
@using static BeamNG_LevelCleanUp.BlazorUI.Components.TerrainMaterialSettings
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<CascadingValue Value="@EffectiveBoundingBox" Name="EffectiveBoundingBox">
<ErrorBoundary>
    <ChildContent>
        <div class="content @(WizardMode ? "wizard-content" : "")">
            <h3>Generate Terrain</h3>
            <MudText Typo="Typo.body2" Class="mb-4">
                Generate a BeamNG terrain (.ter) file from terrain materials and a heightmap.
            </MudText>

            @if (WizardMode && WizardState != null)
            {
                <MudAlert Severity="Severity.Info" Class="mb-4" Icon="@Icons.Material.Filled.Assistant">
                    <MudText Typo="Typo.h6">Create Level Wizard - Generate Terrain</MudText>
                    <MudText Typo="Typo.body2">
                        Target Level: <b>@WizardState.LevelName</b>
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mt-2">
                        @if (_terrainGeneratedInWizard)
                        {
                            <text>Terrain generated! Save your preset above, then finish the wizard.</text>
                        }
                        else
                        {
                            <text>Configure terrain settings and click "Generate Terrain" to create the terrain file for your new level.</text>
                        }
                    </MudText>
                </MudAlert>

                @if (_terrainGeneratedInWizard)
                {
                    <MudAlert Severity="Severity.Success" Class="mb-4" Icon="@Icons.Material.Filled.CheckCircle">
                        <MudText Typo="Typo.h6">Terrain Generated Successfully!</MudText>
                        <MudText Typo="Typo.body2">
                            Your terrain has been created. Remember to save your preset above before finishing.
                        </MudText>
                    </MudAlert>
                }
            }

            @if (!WizardMode)
            {
                <!-- Folder Selection -->
                <MudExpansionPanels @ref="FileSelect">
                    <MudExpansionPanel Text="@GetWorkingDirectoryTitle()" Expanded="@(!_hasWorkingDirectory)">
                        <FileSelectComponent OnFileSelected="OnWorkingDirectorySelected"
                                             SelectFolder="true"
                                             Description="Select the unpacked level folder (contains info.json and art/terrains)">
                        </FileSelectComponent>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }

            @if (_hasWorkingDirectory && !string.IsNullOrEmpty(_levelName))
            {
                @if (!WizardMode)
                {
                    <MudStack Row="true" Spacing="2" Class="mt-4">
                        <MudButton @onclick="ResetPage"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.Refresh">
                            Reset and Select Different Folder
                        </MudButton>
                    </MudStack>
                }

                <!-- Import Preset Section -->
                <TerrainPresetImporter @ref="_presetImporter"
                                       Materials="_terrainMaterials"
                                       WorkingDirectory="@_workingDirectory"
                                       OnPresetImported="OnPresetImported"
                                       Class="mt-4" />

                <!-- Export Preset Section -->
                <TerrainPresetExporter @ref="_presetExporter"
                                       Materials="_terrainMaterials"
                                       WorkingDirectory="@_workingDirectory"
                                       TerrainName="@_terrainName"
                                       TerrainSize="@_terrainSize"
                                       MaxHeight="@_maxHeight"
                                       MetersPerPixel="@_metersPerPixel"
                                       TerrainBaseHeight="@_terrainBaseHeight"
                                       HeightmapPath="@_heightmapPath"
                                       HeightmapSourceType="@_heightmapSourceType"
                                       GeoTiffPath="@_geoTiffPath"
                                       GeoTiffDirectory="@_geoTiffDirectory"
                                       XyzPath="@_state.XyzPath"
                                       XyzFilePaths="@_state.XyzFilePaths"
                                       XyzEpsgCode="@_xyzEpsgCode"
                                       CachedCombinedGeoTiffPath="@_cachedCombinedGeoTiffPath"
                                       UpdateTerrainBlock="@_updateTerrainBlock"
                                       EnableCrossMaterialHarmonization="@_enableCrossMaterialHarmonization"
                                       ExcludeBridgesFromTerrain="@_excludeBridgesFromTerrain"
                                       ExcludeTunnelsFromTerrain="@_excludeTunnelsFromTerrain"
                                       MergeStructuresIntoCorridor="@_mergeStructuresIntoCorridor"
                                       BridgeMaxSagBelowChordMeters="@_bridgeMaxSagBelowChordMeters"
                                       BridgeDeckUndercutMeters="@_bridgeDeckUndercutMeters"
                                       BridgeDeckThicknessSpanRatio="@_bridgeDeckThicknessSpanRatio"
                                       BridgeDeckThicknessMinMeters="@_bridgeDeckThicknessMinMeters"
                                       BridgeDeckThicknessMaxMeters="@_bridgeDeckThicknessMaxMeters"
                                       BridgeParapetHeightMeters="@_bridgeParapetHeightMeters"
                                       BridgeAbutmentDepthMeters="@_bridgeAbutmentDepthMeters"
                                       BridgeRules="@_state.BridgeRules"
                                       TunnelRules="@_state.TunnelRules"
                                       HydraulicErosion="@_state.HydraulicErosion"
                                       EnableBuildings="@_enableBuildings"
                                       EnableBuildingClustering="@_enableBuildingClustering"
                                       BuildingClusterCellSize="@_buildingClusterCellSize"
                                       MaxBuildingLodLevel="@_maxBuildingLodLevel"
                                       BuildingLodBias="@_buildingLodBias"
                                       NullDetailPixelSize="@_nullDetailPixelSize"
                                       SelectedBuildingFeatures="@_state.SelectedBuildingFeatures"
                                       CropOffsetX="@(_cropResult?.OffsetX ?? 0)"
                                       CropOffsetY="@(_cropResult?.OffsetY ?? 0)"
                                       CropWidth="@(_cropResult?.CropWidth ?? 0)"
                                       CropHeight="@(_cropResult?.CropHeight ?? 0)"
                                       GeoTiffOriginalWidth="@_geoTiffOriginalWidth"
                                       GeoTiffOriginalHeight="@_geoTiffOriginalHeight"
                                       GeoTiffProjectionName="@_geoTiffProjectionName"
                                       NativePixelSizeMeters="@GetNativePixelSizeAverage()"
                                       DecalRoadSettings="@_state.DecalRoadSettings"
                                       OnRequestMaterialReorder="HandleMaterialReorderRequest"
                                       Class="mt-4" />

                <!-- Terrain Parameters Section -->
                <MudPaper Class="pa-4 mt-4" Elevation="2">
                    <MudText Typo="Typo.h6" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-2" />
                        Terrain Parameters
                    </MudText>

                    <MudGrid Spacing="3">
                        <!-- Elevation Data Import -->
                        <MudItem xs="12">
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudText Typo="Typo.subtitle2">Elevation Data (Required)</MudText>
                                <MudTooltip Text="Learn about elevation sources and where to get data">
                                    <MudIconButton Icon="@Icons.Material.Filled.Help"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   OnClick="OpenHeightmapSourceHelpDialog" />
                                </MudTooltip>
                            </div>

                            @if (_elevationImportResult == null)
                            {
                                @* Empty state: two native dialog buttons for file and folder selection *@
                                <MudPaper Outlined="true" Class="pa-4" Style="border-radius: 8px;">
                                    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.InsertDriveFile"
                                                   OnClick="ImportElevationFiles"
                                                   Disabled="@_isImportingElevation">
                                            Select Files
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Folder"
                                                   OnClick="ImportElevationFolder"
                                                   Disabled="@_isImportingElevation">
                                            Select Folder
                                        </MudButton>
                                        @if (_isImportingElevation)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                            <MudText Typo="Typo.body2">Importing...</MudText>
                                        }
                                    </MudStack>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                                        <strong>Select Files:</strong> Pick one or multiple files (hold Ctrl/Shift for multi-select).
                                        <strong>Select Folder:</strong> Import all elevation tiles from a directory.
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                        Supported formats: GeoTIFF (.tif, .tiff), XYZ ASCII (.xyz, .txt), PNG heightmap (.png), ZIP archive (.zip)
                                    </MudText>
                                </MudPaper>
                            }
                            else
                            {
                                @* Loaded state: summary card *@
                                <MudPaper Outlined="true" Class="pa-4" Style="border-radius: 8px;">
                                    <div class="d-flex align-center justify-space-between">
                                        <div class="d-flex align-center gap-3">
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Medium" />
                                            <div>
                                                <MudText Typo="Typo.subtitle2">
                                                    @_elevationImportResult.FormatLabel
                                                    @if (_elevationImportResult.FileCount > 1)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ml-2">
                                                            @_elevationImportResult.FileCount files
                                                        </MudChip>
                                                    }
                                                    @if (_elevationImportResult.WasExtractedFromZip)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="ml-1">
                                                            from ZIP
                                                        </MudChip>
                                                    }
                                                </MudText>
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                    @GetFileListSummary()
                                                </MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @GetHeightmapSourceDescription()
                                                </MudText>
                                                @if (_elevationImportResult.SourceType == ElevationSourceType.Png)
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        <strong>File:</strong> @(_elevationImportResult.FilePaths.FirstOrDefault() ?? "—")
                                                    </MudText>
                                                    @if (_elevationImportResult.PngWidth > 0 && _elevationImportResult.PngHeight > 0)
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                            <strong>Image Size:</strong> @_elevationImportResult.PngWidth &times; @_elevationImportResult.PngHeight px
                                                            @if (_elevationImportResult.PngBitDepth > 0)
                                                            {
                                                                <text> (@_elevationImportResult.PngBitDepth-bit)</text>
                                                            }
                                                        </MudText>
                                                    }
                                                }
                                            </div>
                                        </div>
                                        <MudButton Variant="Variant.Text"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.SwapHoriz"
                                                   OnClick="ClearElevationImport">
                                            Change
                                        </MudButton>
                                    </div>

                                    @* XYZ EPSG Code Input *@
                                    @if (_elevationImportResult.NeedsEpsgCode)
                                    {
                                        <MudDivider Class="my-3" />
                                        <div class="d-flex align-center gap-3">
                                            <MudNumericField T="int" @bind-Value="_xyzEpsgCode"
                                                             Label="EPSG Code"
                                                             Variant="Variant.Outlined"
                                                             Min="1000" Max="99999"
                                                             HelperText="@GetEpsgHelperText()"
                                                             Style="max-width: 200px;"
                                                             DebounceInterval="500"
                                                             OnDebounceIntervalElapsed="OnEpsgCodeChanged" />
                                            @if (_elevationImportResult.DetectedEpsgCode.HasValue)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Info">
                                                    Auto-detected: EPSG:@_elevationImportResult.DetectedEpsgCode
                                                </MudChip>
                                            }
                                        </div>
                                    }
                                </MudPaper>
                            }
                        </MudItem>

                        @* GeoTIFF Bounding Box Display *@
                        @if (_geoBoundingBox != null)
                        {
                            <MudItem xs="12">
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                                    <MudText Typo="Typo.subtitle2">
                                        <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" Class="mr-1" />
                                        Geographic Bounding Box @(_cropResult is { NeedsCropping: true, CroppedBoundingBox: not null } ? "(Full GeoTIFF)" : "")
                                    </MudText>
                                    @if (!string.IsNullOrEmpty(_geoTiffProjectionName))
                                    {
                                        <MudText Typo="Typo.body2">
                                            <strong>Projection:</strong> @_geoTiffProjectionName
                                        </MudText>
                                    }
                                    <MudText Typo="Typo.body2">
                                        <strong>SW:</strong> @_geoBoundingBox.MinLatitude.ToString("F6")°, @_geoBoundingBox.MinLongitude.ToString("F6")° |
                                        <strong>NE:</strong> @_geoBoundingBox.MaxLatitude.ToString("F6")°, @_geoBoundingBox.MaxLongitude.ToString("F6")°
                                    </MudText>
                                    @if (_geoTiffMinElevation.HasValue && _geoTiffMaxElevation.HasValue)
                                    {
                                        <MudText Typo="Typo.body2">
                                            <strong>Elevation:</strong> @_geoTiffMinElevation.Value.ToString("F1")m - @_geoTiffMaxElevation.Value.ToString("F1")m
                                            (range: @((_geoTiffMaxElevation.Value - _geoTiffMinElevation.Value).ToString("F1"))m)
                                        </MudText>
                                    }
                                    @if (_geoTiffGeoTransform != null && _geoTiffOriginalWidth > 0)
                                    {
                                        <MudText Typo="Typo.body2">
                                            <strong>DEM Resolution:</strong> @GetNativePixelSizeDescription()
                                        </MudText>
                                        <MudText Typo="Typo.body2">
                                            <strong>Source Size:</strong> @_geoTiffOriginalWidth &times; @_geoTiffOriginalHeight px
                                            (@GetRealWorldWidthKm().ToString("F1")km &times; @GetRealWorldHeightKm().ToString("F1")km)
                                        </MudText>
                                    }
                                    <MudText Typo="Typo.caption" Class="mt-1">
                                        <strong>Overpass API (full):</strong> <code>@_geoBoundingBox.ToOverpassBBox()</code>
                                    </MudText>
                                </MudAlert>

                                @* Show cropped bounding box when cropping is active *@
                                @if (_cropResult is { NeedsCropping: true, CroppedBoundingBox: not null })
                                {
                                    <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">
                                        <MudText Typo="Typo.subtitle2">
                                            <MudIcon Icon="@Icons.Material.Filled.Crop" Size="Size.Small" Class="mr-1" />
                                            Cropped Region (Used for OSM)
                                        </MudText>
                                        <MudText Typo="Typo.body2">
                                            <strong>SW:</strong> @_cropResult.CroppedBoundingBox.MinLatitude.ToString("F6")°, @_cropResult.CroppedBoundingBox.MinLongitude.ToString("F6")° |
                                            <strong>NE:</strong> @_cropResult.CroppedBoundingBox.MaxLatitude.ToString("F6")°, @_cropResult.CroppedBoundingBox.MaxLongitude.ToString("F6")°
                                        </MudText>
                                        @if (_cropResult.CroppedMinElevation.HasValue && _cropResult.CroppedMaxElevation.HasValue)
                                        {
                                            <MudText Typo="Typo.body2">
                                                <strong>Cropped Elevation:</strong> @_cropResult.CroppedMinElevation.Value.ToString("F1")m - @_cropResult.CroppedMaxElevation.Value.ToString("F1")m
                                                (range: @((_cropResult.CroppedMaxElevation.Value - _cropResult.CroppedMinElevation.Value).ToString("F1"))m)
                                            </MudText>
                                        }
                                        <MudText Typo="Typo.caption" Class="mt-1">
                                            <strong>Overpass API (cropped):</strong> <code>@_cropResult.CroppedBoundingBox.ToOverpassBBox()</code>
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Success">
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" />
                                            OSM features will be fetched only for the cropped region
                                        </MudText>
                                    </MudAlert>
                                }
                            </MudItem>
                        }

                        @* OSM Data Availability Warning *@
                        @if (!_canFetchOsmData && !string.IsNullOrEmpty(_osmBlockedReason) &&
                                            _heightmapSourceType != HeightmapSourceType.Png)
                        {
                            <MudItem xs="12">
                                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2" Icon="@Icons.Material.Filled.Warning">
                                    <MudText Typo="Typo.subtitle2">
                                        <MudIcon Icon="@Icons.Material.Filled.LocationOff" Size="Size.Small" Class="mr-1" />
                                        OSM Road Data Not Available
                                    </MudText>
                                    <MudText Typo="Typo.body2">
                                        @_osmBlockedReason
                                    </MudText>
                                    <MudText Typo="Typo.body2" Class="mt-1">
                                        <strong>Possible causes:</strong>
                                    </MudText>
                                    <MudList T="string" Dense="true">
                                        <MudListItem T="string" Dense="true" Icon="@Icons.Material.Filled.ChevronRight">
                                            GeoTIFF has incorrect or missing projection metadata
                                        </MudListItem>
                                        <MudListItem T="string" Dense="true" Icon="@Icons.Material.Filled.ChevronRight">
                                            Coordinate transformation from projected CRS (e.g., UTM) to WGS84 failed
                                        </MudListItem>
                                        <MudListItem T="string" Dense="true" Icon="@Icons.Material.Filled.ChevronRight">
                                            Native coordinates are in meters but metadata claims degrees (lat/lon)
                                        </MudListItem>
                                    </MudList>
                                    <MudText Typo="Typo.caption" Class="mt-1" Color="Color.Secondary">
                                        You can still generate terrain, but "OSM Features" layer source will not work.
                                        Use PNG layer maps instead for road materials.
                                    </MudText>
                                    @if (_geoTiffValidationResult?.DiagnosticInfo?.Any() == true)
                                    {
                                        <MudExpansionPanels Class="mt-2" Dense="true">
                                            <MudExpansionPanel Text="Show Diagnostic Details" Dense="true">
                                                <MudList T="string" Dense="true">
                                                    @foreach (var diag in _geoTiffValidationResult.DiagnosticInfo)
                                                    {
                                                        <MudListItem T="string" Dense="true">
                                                            <MudText Typo="Typo.caption" Style="font-family: monospace;">@diag</MudText>
                                                        </MudListItem>
                                                    }
                                                </MudList>
                                            </MudExpansionPanel>
                                        </MudExpansionPanels>
                                    }
                                </MudAlert>
                            </MudItem>
                        }

                        @* Crop Settings (when image is larger than terrain) *@
                        @if (_geoTiffOriginalWidth > 0 && _geoTiffOriginalHeight > 0 &&
                                            _heightmapSourceType != HeightmapSourceType.Png)
                        {
                            <MudItem xs="12">
                                <CropAnchorSelector @ref="_cropAnchorSelector"
                                                    Title="GeoTIFF Selection Region"
                                                    OriginalWidth="@_geoTiffOriginalWidth"
                                                    OriginalHeight="@_geoTiffOriginalHeight"
                                                    TargetSize="@_terrainSize"
                                                    TargetSizeChanged="OnCropTargetSizeChanged"
                                                    MetersPerPixel="@_metersPerPixel"
                                                    MetersPerPixelChanged="OnCropMetersPerPixelChanged"
                                                    NativePixelSizeMeters="@GetNativePixelSizeAverage()"
                                                    SelectedAnchor="@_cropAnchor"
                                                    SelectedAnchorChanged="OnCropAnchorChanged"
                                                    OriginalBoundingBox="@_geoBoundingBox"
                                                    CropResultChanged="OnCropResultChanged" />
                                @if (_cropResult is { NeedsCropping: true })
                                {
                                    <div class="d-flex align-center gap-2 mt-2">
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Warning"
                                                   StartIcon="@Icons.Material.Filled.ContentCut"
                                                   OnClick="ReduceGeoTiffToCropAsync"
                                                   Disabled="@(_isGenerating || _isReducingGeoTiff)"
                                                   Size="Size.Small">
                                            @if (_isReducingGeoTiff)
                                            {
                                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                                <span>Reducing...</span>
                                            }
                                            else
                                            {
                                                <span>Reduce GeoTIFF to Selection</span>
                                            }
                                        </MudButton>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            Creates a smaller GeoTIFF from the selected region only. Re-import files to expand.
                                        </MudText>
                                    </div>
                                }
                            </MudItem>
                        }

                        <!-- Terrain Size -->
                        <MudItem xs="12" sm="6" md="3">
                            <MudSelect T="int"
                                       @bind-Value="_terrainSize"
                                       Label="Terrain Size"
                                       Variant="Variant.Outlined"
                                       HelperText="Size in pixels (power of 2)">
                                <MudSelectItem Value="256">256 x 256</MudSelectItem>
                                <MudSelectItem Value="512">512 x 512</MudSelectItem>
                                <MudSelectItem Value="1024">1024 x 1024</MudSelectItem>
                                <MudSelectItem Value="2048">2048 x 2048</MudSelectItem>
                                <MudSelectItem Value="4096">4096 x 4096</MudSelectItem>
                                <MudSelectItem Value="8192">8192 x 8192</MudSelectItem>
                                <MudSelectItem Value="16384">16384 x 16384</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <!-- Max Height -->
                        <MudItem xs="12" sm="6" md="3">
                            <MudNumericField @bind-Value="_maxHeight"
                                             Label="Max Height (m)"
                                             Variant="Variant.Outlined"
                                             Min="0.0f" Max="10000.0f" Step="10.0f"
                                             HelperText="@(_heightmapSourceType != HeightmapSourceType.Png ? "Set to 0 to auto-calculate from GeoTIFF" : "Maximum terrain elevation")" />
                        </MudItem>

                        <!-- Meters Per Pixel -->
                        <MudItem xs="12" sm="6" md="3">
                            <MudNumericField @bind-Value="_metersPerPixel"
                                             Label="Meters Per Pixel"
                                             Variant="Variant.Outlined"
                                             Min="0.1f" Max="100.0f" Step="0.1f"
                                             HelperText="@GetMetersPerPixelHelperText()" />
                        </MudItem>

                        <!-- Terrain Name -->
                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField @bind-Value="_terrainName"
                                          Label="Terrain Name"
                                          Variant="Variant.Outlined"
                                          HelperText="Output filename (without .ter)" />
                        </MudItem>

                        <!-- Terrain Base Height -->
                        <MudItem xs="12" sm="6" md="3">
                            <MudNumericField @bind-Value="_terrainBaseHeight"
                                             Label="Base Height (m)"
                                             Variant="Variant.Outlined"
                                             Min="-10000.0f" Max="10000.0f" Step="1.0f"
                                             HelperText="@(_heightmapSourceType != HeightmapSourceType.Png ? "Auto-calculated from GeoTIFF min elevation" : "Z position offset for terrain")" />
                        </MudItem>

                        @* Hydraulic Erosion *@
                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2" Class="mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.WaterDrop" Size="Size.Small" Class="mr-1" />
                                Hydraulic Erosion
                            </MudText>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="3">
                            <div class="d-flex align-center gap-1">
                                <MudCheckBox @bind-Value="_enableHydraulicErosion"
                                             Label="Enable Hydraulic Erosion"
                                             Color="Color.Primary" />
                                <MudTooltip Text="Runs a droplet-based erosion pass after elevation import and before road smoothing.">
                                    <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                </MudTooltip>
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Naturalize terrain before roads are smoothed
                            </MudText>
                        </MudItem>

                        @if (_enableHydraulicErosion)
                        {
                            <MudItem xs="12" sm="6" md="3">
                                <MudNumericField T="int"
                                                 @bind-Value="_hydraulicErosionIterations"
                                                 Label="Iterations"
                                                 Variant="Variant.Outlined"
                                                 Min="1" Max="1000000" Step="1000"
                                                 HelperText="More iterations increase detail and processing time" />
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <MudNumericField T="int"
                                                 @bind-Value="_hydraulicErosionRadius"
                                                 Label="Erosion Radius"
                                                 Variant="Variant.Outlined"
                                                 Min="1" Max="16" Step="1"
                                                 HelperText="Brush radius in terrain pixels" />
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <MudNumericField T="int"
                                                 @bind-Value="_hydraulicErosionSeed"
                                                 Label="Random Seed"
                                                 Variant="Variant.Outlined"
                                                 Step="1"
                                                 HelperText="Same seed gives repeatable erosion" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudExpansionPanels Dense="true">
                                    <MudExpansionPanel Text="Advanced Erosion Settings" Dense="true">
                                        <MudGrid Spacing="3">
                                            <MudItem xs="12" sm="6" md="3">
                                                <MudNumericField T="float" @bind-Value="_hydraulicErosionInertia"
                                                                 Label="Inertia" Variant="Variant.Outlined"
                                                                 Min="0.0f" Max="1.0f" Step="0.01f"
                                                                 HelperText="Higher values keep droplets moving in the same direction longer" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6" md="3">
                                                <MudNumericField T="float" @bind-Value="_hydraulicErosionGravity"
                                                                 Label="Gravity" Variant="Variant.Outlined"
                                                                 Min="0.0f" Max="20.0f" Step="0.25f"
                                                                 HelperText="Controls how strongly downhill slopes accelerate droplets" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6" md="3">
                                                <MudNumericField T="int" @bind-Value="_hydraulicErosionDropletLifetime"
                                                                 Label="Droplet Lifetime" Variant="Variant.Outlined"
                                                                 Min="1" Max="200" Step="1"
                                                                 HelperText="Maximum simulation steps for each water droplet" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6" md="3">
                                                <MudNumericField T="float" @bind-Value="_hydraulicErosionCapacityFactor"
                                                                 Label="Capacity Factor" Variant="Variant.Outlined"
                                                                 Min="0.0f" Max="20.0f" Step="0.1f"
                                                                 HelperText="Higher values let moving water carry more sediment" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6" md="3">
                                                <MudNumericField T="float" @bind-Value="_hydraulicErosionMinCapacity"
                                                                 Label="Min Capacity" Variant="Variant.Outlined"
                                                                 Min="0.0f" Max="1.0f" Step="0.001f"
                                                                 HelperText="Minimum sediment capacity on flat or slow terrain" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6" md="3">
                                                <MudNumericField T="float" @bind-Value="_hydraulicErosionErodeSpeed"
                                                                 Label="Erode Speed" Variant="Variant.Outlined"
                                                                 Min="0.0f" Max="1.0f" Step="0.01f"
                                                                 HelperText="Fraction of available sediment capacity eroded per step" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6" md="3">
                                                <MudNumericField T="float" @bind-Value="_hydraulicErosionDepositSpeed"
                                                                 Label="Deposit Speed" Variant="Variant.Outlined"
                                                                 Min="0.0f" Max="1.0f" Step="0.01f"
                                                                 HelperText="Fraction of excess sediment dropped per step" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6" md="3">
                                                <MudNumericField T="float" @bind-Value="_hydraulicErosionEvaporateSpeed"
                                                                 Label="Evaporation" Variant="Variant.Outlined"
                                                                 Min="0.0f" Max="1.0f" Step="0.01f"
                                                                 HelperText="Water loss per step; higher values shorten erosion paths" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6" md="3">
                                                <MudNumericField T="float" @bind-Value="_hydraulicErosionInitialWater"
                                                                 Label="Initial Water" Variant="Variant.Outlined"
                                                                 Min="0.0001f" Max="10.0f" Step="0.1f"
                                                                 HelperText="Starting water volume for each droplet" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6" md="3">
                                                <MudNumericField T="float" @bind-Value="_hydraulicErosionInitialSpeed"
                                                                 Label="Initial Speed" Variant="Variant.Outlined"
                                                                 Min="0.0f" Max="10.0f" Step="0.1f"
                                                                 HelperText="Starting movement speed before slope acceleration" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            </MudItem>
                        }

                        @* UpdateTerrainBlock: always true, UI removed *@
                        @* FlipMaterialProcessingOrder: always false, UI removed *@
                        @* Cross-Material Harmonization: always enabled, UI removed *@

                        @* Road Network *@
                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2" Class="mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.Timeline" Size="Size.Small" Class="mr-1" />
                                Road Network
                            </MudText>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="3">
                            <div class="d-flex align-center gap-1">
                                <MudCheckBox @bind-Value="_disableSplineMerging"
                                             Label="Disable Spline Merging"
                                             Color="Color.Warning" />
                                <MudTooltip Text="Keeps every OSM way as its own spline instead of merging connected ways into longer roads. Debugging aid for wrong merge results at complex junctions; merged splines are needed for smooth, continuous roads.">
                                    <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                </MudTooltip>
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Debugging: one spline per OSM way
                            </MudText>
                        </MudItem>

                        @* Bridges & Tunnels *@
                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2" Class="mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.Architecture" Size="Size.Small" Class="mr-1" />
                                Bridges &amp; Tunnels
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                                How bridges and tunnels from the OSM data are handled during terrain generation.
                            </MudText>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="3">
                            <div class="d-flex align-center gap-1">
                                <MudCheckBox T="bool"
                                             Value="_excludeBridgesFromTerrain"
                                             ValueChanged="OnExcludeBridgesFromTerrainChanged"
                                             Label="Generate Bridges"
                                             Disabled="@(_isGenerating || _isAnalyzing)"
                                             Color="Color.Primary" />
                                <MudTooltip Text="Builds roads tagged as bridges in OSM as elevated decks with abutments and leaves the terrain below them untouched. When off, bridge roads are pressed into the terrain like normal roads.">
                                    <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                </MudTooltip>
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Build OSM bridges as elevated decks
                            </MudText>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="3">
                            <div class="d-flex align-center gap-1">
                                <MudCheckBox T="bool"
                                             Value="_excludeTunnelsFromTerrain"
                                             ValueChanged="OnExcludeTunnelsFromTerrainChanged"
                                             Label="Generate Tunnels"
                                             Disabled="@(_isGenerating || _isAnalyzing)"
                                             Color="Color.Primary" />
                                <MudTooltip Text="Builds roads tagged as tunnels in OSM as drivable tube meshes through the terrain: portal-anchored floor profile, arched bore with portal headwalls, terrain holes cut at the portal mouths. The mountain above deep sections stays untouched. When off, tunnel roads are pressed into the terrain surface like normal roads.">
                                    <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                </MudTooltip>
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Build OSM tunnels as drivable tubes
                            </MudText>
                        </MudItem>

                        @* Bridge tuning values. The bridge rule system itself (clearance planning, raise/dip
                           sharing, deck profiles, span consolidation, …) is always on — the former per-rule
                           feature flags are forced true in TerrainGenerationState and on preset import. *@
                        @* Always rendered, only CSS-hidden while bridges are off: MudNumericFields
                           CREATED after the initial render show an empty input until blurred
                           (MudBlazor text sync), so the fields must exist from the start and merely
                           toggle visibility. display:contents keeps the MudItems direct children of
                           the grid layout. *@
                        <div style="@(_excludeBridgesFromTerrain ? "display: contents" : "display: none")">
                            <MudItem xs="12">
                                <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Clearances</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                                    Vertical space kept between the underside of a deck and whatever passes below it.
                                    Where a crossing is too tight, the deck is raised or the lower road is dipped until the clearance fits.
                                </MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_state.BridgeRules.RoadClearanceMeters"
                                                     Label="Road Clearance (m)"
                                                     Min="2f" Max="8f" Step="0.1f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="Minimum clearance over a road passing under a bridge. Also used for crossings whose type cannot be determined.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Over roads (default 4.7)</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_state.BridgeRules.RailClearanceElectrifiedMeters"
                                                     Label="Electrified Rail Clearance (m)"
                                                     Min="3f" Max="9f" Step="0.1f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="Minimum clearance over an electrified railway — the overhead wires need extra room. Railways are never lowered; the deck is raised instead.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Over electrified rail (default 6.0)</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_state.BridgeRules.RailClearanceNonElectrifiedMeters"
                                                     Label="Rail Clearance (m)"
                                                     Min="3f" Max="9f" Step="0.1f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="Minimum clearance over a non-electrified railway. Railways are never lowered; the deck is raised instead.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Over non-electrified rail (default 5.0)</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_state.BridgeRules.NavigableWaterClearanceMeters"
                                                     Label="Navigable Water Clearance (m)"
                                                     Min="1f" Max="12f" Step="0.25f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="Minimum clearance over navigable water such as canals and shipping rivers.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Over navigable water (default 5.25)</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_state.BridgeRules.WaterFreeboardMeters"
                                                     Label="Water Freeboard (m)"
                                                     Min="0f" Max="6f" Step="0.25f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="Minimum clearance over streams and other non-navigable water.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Over streams (default 2.0)</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_state.BridgeRules.StructuralDepthMaxMeters"
                                                     Label="Max Structural Depth (m)"
                                                     Min="0.2f" Max="6.5f" Step="0.1f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="Upper limit for the deck depth added to the clearance budget on long spans. Keep close to Max Deck Thickness, otherwise the road surface floats above the visible deck.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Clearance budget limit (default 2.0)</MudText>
                            </MudItem>

                            <MudItem xs="12">
                                <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Bridge Deck</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                                    Shape and dimensions of the generated deck.
                                </MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_bridgeDeckThicknessSpanRatio"
                                                     Label="Deck Thickness Ratio"
                                                     Min="0f" Max="0.5f" Step="0.01f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="Deck thickness as a fraction of the span length, clamped between the min and max values.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Thickness = ratio × span (default 0.05)</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_bridgeDeckThicknessMinMeters"
                                                     Label="Min Deck Thickness (m)"
                                                     Min="0f" Max="10f" Step="0.05f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="Lower limit for the deck thickness, so short bridges still get a plausible deck.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Default 0.45</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_bridgeDeckThicknessMaxMeters"
                                                     Label="Max Deck Thickness (m)"
                                                     Min="0f" Max="20f" Step="0.25f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="Upper limit for the deck thickness, so long bridges don't get an overly deep deck.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Default 1.2</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_bridgeParapetHeightMeters"
                                                     Label="Parapet Height (m)"
                                                     Min="0f" Max="3f" Step="0.1f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="Height of the side barriers along the deck. 0 removes them.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Default 0.9</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_bridgeMaxSagBelowChordMeters"
                                                     Label="Max Deck Sag (m)"
                                                     Min="0f" Max="10f" Step="0.25f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="How far the deck may bow below the straight line between its endpoints before it is flattened back toward that line. Lower values give a flatter deck but a sharper bend where deck and road meet.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Default 1.0</MudText>
                            </MudItem>

                            <MudItem xs="12">
                                <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Abutments &amp; Terrain</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                                    How the deck ends and the terrain underneath the bridge meet the deck.
                                </MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_bridgeAbutmentDepthMeters"
                                                     Label="Abutment Depth (m)"
                                                     Min="0f" Max="5f" Step="0.1f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="How far the solid block at each bridge end reaches below the underside of the deck.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Default 1.0</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_state.BridgeRules.AbutmentOverlapMeters"
                                                     Label="Abutment Overlap (m)"
                                                     Min="0f" Max="10f" Step="0.5f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="The terrain road surface continues this far underneath each deck end, so no gap or lip opens between terrain and deck. 0 disables the overlap.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Default 3</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_state.BridgeRules.AbutmentOverlapDropMeters"
                                                     Label="Overlap Drop (m)"
                                                     Min="-1f" Max="0.5f" Step="0.005f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="How far the overlap surface sits below the deck, so the deck stays the visible road surface without flickering.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Default 0.01</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_bridgeDeckUndercutMeters"
                                                     Label="Deck Undercut (m)"
                                                     Min="0f" Max="2f" Step="0.05f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="Terrain that pokes up through a deck is shaved to this depth below the deck surface, so terrain and deck don't flicker against each other.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Default 0.05</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudSelect T="string"
                                               @bind-Value="_underDeckMaterialName"
                                               Label="Under-Deck Material"
                                               Disabled="@(_isGenerating || _isAnalyzing)"
                                               Clearable="true"
                                               Variant="Variant.Text">
                                        @foreach (var name in _underDeckMaterialOptions)
                                        {
                                            <MudSelectItem T="string" Value="@name">@name</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudTooltip Text="Terrain material painted underneath each deck, so grass and other groundcover don't grow through it. Only terrain close under the deck is repainted; ravines and water under tall spans keep their material. Empty = no repaint.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Stops plants growing through decks</MudText>
                            </MudItem>

                            <MudItem xs="12">
                                <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Piers</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                                    Support columns under long bridges.
                                </MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudCheckBox T="bool"
                                                 @bind-Value="_state.BridgeRules.EnableBridgePiers"
                                                 Label="Bridge Piers"
                                                 Disabled="@(_isGenerating || _isAnalyzing)"
                                                 Color="Color.Primary" />
                                    <MudTooltip Text="Places piers (cap and columns) under bridge decks longer than the minimum span, styled after the bridge's OSM tags. A pier never stands on a road, railway, building, navigable waterway or a lower deck — it moves aside or is skipped. Suspension and cable-stayed bridges get no piers.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Generate supports under long bridges</MudText>
                            </MudItem>

                            <div style="@(_state.BridgeRules.EnableBridgePiers ? "display: contents" : "display: none")">
                                <MudItem xs="12" sm="6" md="3">
                                    <div class="d-flex align-center gap-1">
                                        <MudNumericField T="float"
                                                         @bind-Value="_state.BridgeRules.MinSpanLengthForPiersMeters"
                                                         Label="Min Span for Piers (m)"
                                                         Min="10f" Max="100f" Step="5f"
                                                         Disabled="@(_isGenerating || _isAnalyzing)"
                                                         Variant="Variant.Text" />
                                        <MudTooltip Text="Bridges shorter than this get abutments only, no piers.">
                                            <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                        </MudTooltip>
                                    </div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Default 35</MudText>
                                </MudItem>

                                <MudItem xs="12" sm="6" md="3">
                                    <div class="d-flex align-center gap-1">
                                        <MudNumericField T="float"
                                                         @bind-Value="_state.BridgeRules.PierSpacingMeters"
                                                         Label="Pier Spacing (m)"
                                                         Min="10f" Max="80f" Step="5f"
                                                         Disabled="@(_isGenerating || _isAnalyzing)"
                                                         Variant="Variant.Text" />
                                        <MudTooltip Text="Target distance between piers along the deck. Obstacles can push individual piers aside or drop them, widening the gap.">
                                            <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                        </MudTooltip>
                                    </div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Default 30</MudText>
                                </MudItem>

                                <MudItem xs="12" sm="6" md="3">
                                    <div class="d-flex align-center gap-1">
                                        <MudNumericField T="float"
                                                         @bind-Value="_state.BridgeRules.MinPierHeightMeters"
                                                         Label="Min Pier Height (m)"
                                                         Min="0.5f" Max="10f" Step="0.5f"
                                                         Disabled="@(_isGenerating || _isAnalyzing)"
                                                         Variant="Variant.Text" />
                                        <MudTooltip Text="No pier where the underside of the deck is closer than this to the ground — a low deck sits on its embankment.">
                                            <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                        </MudTooltip>
                                    </div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Default 2.5</MudText>
                                </MudItem>

                                <MudItem xs="12" sm="6" md="3">
                                    <div class="d-flex align-center gap-1">
                                        <MudNumericField T="float"
                                                         @bind-Value="_state.BridgeRules.PierClearanceMarginMeters"
                                                         Label="Pier Keep-Out Margin (m)"
                                                         Min="0f" Max="10f" Step="0.5f"
                                                         Disabled="@(_isGenerating || _isAnalyzing)"
                                                         Variant="Variant.Text" />
                                        <MudTooltip Text="Extra distance piers keep from roads, railways, buildings and lower decks. Larger values skip more piers.">
                                            <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                        </MudTooltip>
                                    </div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Default 3</MudText>
                                </MudItem>

                                <MudItem xs="12" sm="6" md="3">
                                    <div class="d-flex align-center gap-1">
                                        <MudNumericField T="float"
                                                         @bind-Value="_state.BridgeRules.PierColumnDiameterMeters"
                                                         Label="Pier Column Diameter (m)"
                                                         Min="0.4f" Max="4f" Step="0.1f"
                                                         Disabled="@(_isGenerating || _isAnalyzing)"
                                                         Variant="Variant.Text" />
                                        <MudTooltip Text="Diameter of the pier columns. Wide decks get two columns side by side.">
                                            <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                        </MudTooltip>
                                    </div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Default 1.2</MudText>
                                </MudItem>

                                <MudItem xs="12" sm="6" md="3">
                                    <div class="d-flex align-center gap-1">
                                        <MudNumericField T="float"
                                                         @bind-Value="_state.BridgeRules.MaxPierSlideMeters"
                                                         Label="Max Pier Slide (m)"
                                                         Min="0f" Max="30f" Step="1f"
                                                         Disabled="@(_isGenerating || _isAnalyzing)"
                                                         Variant="Variant.Text" />
                                        <MudTooltip Text="How far a pier may move from its regular position to clear an obstacle before it is dropped.">
                                            <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                        </MudTooltip>
                                    </div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Default 12</MudText>
                                </MudItem>
                            </div>
                        </div>

                        @* Tunnel tuning values. Like the bridge rules, the tunnel rule system itself
                           (profile solve, mesh, portal holes/aprons) is always on — gated only by the
                           "Generate Tunnels" switch. Same CSS-hidden pattern (MudNumericField text sync). *@
                        <div style="@(_excludeTunnelsFromTerrain ? "display: contents" : "display: none")">
                            <MudItem xs="12">
                                <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Tunnel Bore</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                                    Dimensions of the generated tunnel tube and its portals.
                                </MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_state.TunnelRules.TunnelInteriorHeightMeters"
                                                     Label="Interior Height (m)"
                                                     Min="3f" Max="10f" Step="0.1f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="Height from the tunnel floor to the apex of the ceiling arch.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Floor to ceiling apex (default 5.0)</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_state.TunnelRules.TunnelWallThicknessMeters"
                                                     Label="Wall Thickness (m)"
                                                     Min="0.2f" Max="2f" Step="0.1f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="Thickness of the tube shell between the interior surface and the outside of the tunnel structure.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Interior to outer shell (default 0.6)</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_state.TunnelRules.TunnelSideClearanceMeters"
                                                     Label="Side Clearance (m)"
                                                     Min="0f" Max="3f" Step="0.1f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="Extra space between the edge of the roadway and the tunnel wall, per side.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Roadway edge to wall (default 1.0)</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_state.TunnelRules.PortalApronMeters"
                                                     Label="Portal Apron (m)"
                                                     Min="0f" Max="10f" Step="0.5f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="Length of ordinary surface road kept at each tunnel end, so the road runs into the portal on real terrain before the tube takes over.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Stamped road into the portal (default 3.0)</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_state.TunnelRules.PortalHeadwallFlareMeters"
                                                     Label="Portal Wall Size (m)"
                                                     Min="0f" Max="20f" Step="0.5f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="How far the portal front wall extends beyond the tube - left, right and up - to hide the ragged terrain hole edge around the mouth.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Face plate beyond the tube (default 5.0)</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_state.TunnelRules.PortalHeadwallDepthMeters"
                                                     Label="Portal Wall Depth (m)"
                                                     Min="0.1f" Max="20f" Step="0.1f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="Thickness of the portal front wall, extruded into the mountain - makes it a solid block visible from every side, not a thin plate.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Solid wall thickness (default 10.0)</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_state.TunnelRules.PortalFloorTongueMeters"
                                                     Label="Portal Floor Tongue (m)"
                                                     Min="0f" Max="15f" Step="0.5f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="Drivable floor slab extended out of each portal toward the road, slightly below the road surface - catches the wheels where the terrain hole edge is imprecise.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Safety slab out of the mouth (default 6.0)</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_state.TunnelRules.TunnelMinCoverMeters"
                                                     Label="Min Cover (m)"
                                                     Min="0f" Max="20f" Step="0.5f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="Terrain cover wanted above the tunnel roof. Shallow stretches are reported in the log; the terrain there becomes part of the portal opening.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Terrain above the roof (default 5.0)</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <div class="d-flex align-center gap-1">
                                    <MudNumericField T="float"
                                                     @bind-Value="_state.TunnelRules.TunnelMaxGradePercent"
                                                     Label="Max Grade (%)"
                                                     Min="1f" Max="20f" Step="0.5f"
                                                     Disabled="@(_isGenerating || _isAnalyzing)"
                                                     Variant="Variant.Text" />
                                    <MudTooltip Text="Steepest longitudinal slope expected inside a tunnel. Steeper profiles are only reported in the log — they are never flattened automatically.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Warn-only threshold (default 6.0)</MudText>
                            </MudItem>
                        </div>

                        @* Building Generation *@
                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2" Class="mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.Apartment" Size="Size.Small" Class="mr-1" />
                                Building Generation
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                                Generate 3D buildings from OSM building footprints.
                            </MudText>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="3">
                            <div class="d-flex align-center gap-1">
                                <MudCheckBox @bind-Value="_enableBuildings"
                                             Label="Enable Buildings"
                                             Color="Color.Warning"
                                             Disabled="@(!_canFetchOsmData)" />
                                <MudTooltip Text="Generate 3D buildings from selected OSM building footprints after terrain creation.">
                                    <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                </MudTooltip>
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @if (!_canFetchOsmData)
                                { <text>Requires GeoTIFF source with OSM data</text> }
                                else
                                { <text>Generate buildings from OSM footprints</text> }
                            </MudText>
                        </MudItem>

                        @if (_enableBuildings)
                        {
                            <MudItem xs="12">
                                <div class="d-flex align-center gap-2 mb-2">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">
                                        @(_state.SelectedBuildingFeatures.Count) building@(_state.SelectedBuildingFeatures.Count != 1 ? "s" : "") selected
                                    </MudChip>
                                    <MudButton Variant="Variant.Filled" Color="Color.Warning"
                                               StartIcon="@Icons.Material.Filled.Apartment"
                                               OnClick="OpenBuildingFeatureSelector" Size="Size.Small">
                                        Select Buildings
                                    </MudButton>
                                    @if (_state.SelectedBuildingFeatures.Any())
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Clear"
                                                      Color="Color.Error" Size="Size.Small"
                                                      OnClick="ClearBuildingFeatures" />
                                    }
                                </div>
                                @if (_state.SelectedBuildingFeatures.Any())
                                {
                                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                        @foreach (var feature in _state.SelectedBuildingFeatures.Take(10))
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                                     Variant="Variant.Outlined"
                                                     OnClose="@(() => RemoveBuildingFeature(feature))">
                                                @feature.DisplayName
                                            </MudChip>
                                        }
                                        @if (_state.SelectedBuildingFeatures.Count > 10)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default">
                                                +@(_state.SelectedBuildingFeatures.Count - 10) more
                                            </MudChip>
                                        }
                                    </MudStack>
                                }
                            </MudItem>

                            @* Building Clustering *@
                            <MudItem xs="12" sm="6" md="4">
                                <div class="d-flex align-center gap-1 mb-1">
                                    <MudText Typo="Typo.subtitle2">Building Clustering</MudText>
                                    <MudTooltip Text="Merge nearby buildings into combined 3D models to reduce draw calls in-game. Buildings are grouped by grid cells. Larger cell size = fewer draw calls but coarser LOD grouping. Recommended for areas with many buildings.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudSelect T="float"
                                           Value="_buildingClusterCellSize"
                                           ValueChanged="OnBuildingClusterCellSizeChanged"
                                           Label="Cluster Cell Size"
                                           Variant="Variant.Outlined"
                                           HelperText="@GetClusterCellSizeHelperText()">
                                    <MudSelectItem T="float" Value="0f">Off (one DAE per building)</MudSelectItem>
                                    @foreach (var opt in GetClusterCellSizeOptions())
                                    {
                                        <MudSelectItem T="float" Value="@opt.Value">@opt.Label</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            @* Building LOD Settings *@
                            <MudItem xs="12" sm="6" md="4">
                                <div class="d-flex align-center gap-1 mb-1">
                                    <MudText Typo="Typo.subtitle2">Max LOD Level</MudText>
                                    <MudTooltip Text="Controls how many detail levels are included in each building DAE file. LOD0 = walls and roof only (fastest, smallest files). LOD1 adds textured window quads. LOD2 adds full 3D windows, doors, and frames (highest quality, largest files). Lower values reduce file size and improve performance at the cost of visual detail.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudSelect T="int"
                                           @bind-Value="_maxBuildingLodLevel"
                                           Label="Max Detail Level"
                                           Variant="Variant.Outlined"
                                           HelperText="@GetMaxLodHelperText()">
                                    <MudSelectItem T="int" Value="0">LOD0 — Walls + Roof only</MudSelectItem>
                                    <MudSelectItem T="int" Value="1">LOD1 — + Textured Windows</MudSelectItem>
                                    <MudSelectItem T="int" Value="2">LOD2 — + 3D Windows &amp; Doors</MudSelectItem>
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="4">
                                <div class="d-flex align-center gap-1 mb-1">
                                    <MudText Typo="Typo.subtitle2">LOD Distance Bias</MudText>
                                    <MudTooltip Text="Adjusts when LOD transitions occur relative to camera distance. At 1.0 (default), a typical 15m building switches detail levels at standard distances. Values above 1.0 make detail drop off sooner (better performance). Values below 1.0 retain detail longer at distance (better visuals). The actual pixel thresholds scale automatically with building size.">
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Secondary" />
                                    </MudTooltip>
                                </div>
                                <MudSlider T="float"
                                           @bind-Value="_buildingLodBias"
                                           Min="0.25f" Max="4.0f" Step="0.25f"
                                           Color="Color.Warning"
                                           TickMarks="true"
                                           TickMarkLabels="@(new[] { "0.25", "", "", "1.0", "", "", "", "2.0", "", "", "", "3.0", "", "", "", "4.0" })"
                                           ValueLabel="true">
                                    LOD Bias: @_buildingLodBias.ToString("F2")x
                                </MudSlider>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="4">
                                <MudNumericField T="int"
                                                 @bind-Value="_nullDetailPixelSize"
                                                 Label="Null-Detail Pixel Size"
                                                 Variant="Variant.Outlined"
                                                 Min="0"
                                                 HelperText="@(_nullDetailPixelSize > 0 ? $"Objects smaller than {_nullDetailPixelSize}px on screen won't render" : "Disabled — objects always render")"
                                                 Adornment="Adornment.End"
                                                 AdornmentText="px" />
                            </MudItem>
                        }

                    </MudGrid>
                </MudPaper>
            }

            @* DecalRoad Generation Section *@
            @if (_canFetchOsmData)
            {
                <MudPaper Class="pa-4 mt-4" Elevation="1">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.LinearScale" Size="Size.Small" Class="mr-1" />
                        Road Width, Lanes &amp; DecalRoad Definition
                    </MudText>
                    <MudCheckBox @bind-Value="_enableDecalRoads"
                                 Label="Enable DecalRoad and AI-Road generation"
                                 Color="Color.Primary" />
                    @if (_enableDecalRoads)
                    {
                        <MudText Typo="Typo.body2" Class="mt-2 mb-2">
                            Defines road lane counts, widths, visual detail layers (edge lines, lane markings, edge blends)
                            and AI road paths. Settings here apply globally via layer set defaults. Per-material overrides available below.
                        </MudText>
                        <MudGrid Spacing="2" Class="mb-3">
                            <MudItem xs="12" sm="4">
                                <MudNumericField T="float"
                                                 Value="@GetDecalRoadNodeSpacing()"
                                                 ValueChanged="SetDecalRoadNodeSpacing"
                                                 Label="Node Spacing (m)"
                                                 Variant="Variant.Outlined"
                                                 Min="0.5f" Max="15.0f" Step="0.5f"
                                                 HelperText="Distance between DecalRoad nodes" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudNumericField T="float"
                                                 Value="@GetDecalRoadJunctionMargin()"
                                                 ValueChanged="SetDecalRoadJunctionMargin"
                                                 Label="Junction Margin (m)"
                                                 Variant="Variant.Outlined"
                                                 Min="-5.0f" Max="20.0f" Step="0.5f"
                                                 HelperText="Extra corridor margin at junctions" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudNumericField T="int"
                                                 Value="@GetDecalRoadRandomSeed()"
                                                 ValueChanged="SetDecalRoadRandomSeed"
                                                 Label="Random Seed"
                                                 Variant="Variant.Outlined"
                                                 Step="1"
                                                 HelperText="Seed for randomizer constraint" />
                            </MudItem>
                        </MudGrid>
                        <div class="d-flex gap-2 align-center">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Settings"
                                       OnClick="OpenDefaultLayerSetsDialog">
                                Edit Default Layer Sets
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       Disabled="@(!CanRegenerateDecalRoads() || _isGenerating)"
                                       OnClick="RegenerateDecalRoads">
                                Re-generate DecalRoads
                            </MudButton>
                        </div>
                        @if (!CanRegenerateDecalRoads())
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-1">
                                Generate terrain first to enable re-generation.
                            </MudText>
                        }
                        else if (_state.CachedNetwork == null)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Info" Class="mt-1">
                                Will load road network from saved snapshot.
                            </MudText>
                        }
                    }
                </MudPaper>
            }

            @if (_terrainMaterials.Any())
            {
                <!-- Materials Section with Drag-Drop -->
                <MudPaper Class="pa-4 mt-4" Elevation="2">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.Terrain" Class="mr-2" />
                            Terrain Materials (@_terrainMaterials.Count)
                        </MudText>
                        <MudTooltip Text="Learn about material order and priority">
                            <MudIconButton Icon="@Icons.Material.Filled.Help"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           OnClick="OpenMaterialOrderHelpDialog" />
                        </MudTooltip>
                    </div>
                    <MudText Typo="Typo.body2" Class="mb-4" Color="Color.Secondary">
                        Drag and drop to change the order. Material at index 0 is the default/fallback material.
                        Expand each material to configure layer maps and road smoothing.
                    </MudText>

                    <MudDropContainer T="TerrainMaterialItemExtended"
                                      @ref="_dropContainer"
                                      Items="@_terrainMaterials"
                                      ItemsSelector="@((item, dropzone) => item.Selector == dropzone)"
                                      ItemDropped="OnMaterialDropped"
                                      Class="d-flex flex-column">
                        <ChildContent>
                            <MudDropZone T="TerrainMaterialItemExtended"
                                         Identifier="materials"
                                         Class="mud-height-full"
                                         AllowReorder="true">
                            </MudDropZone>
                        </ChildContent>
                        <ItemRenderer>
                            <MudPaper Class="pa-1 mb-1" Elevation="0" Outlined="true">
                                <div class="d-flex align-center">
                                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator"
                                             Class="mr-1"
                                             Style="cursor: move;"
                                             Color="Color.Default" />
                                    <div class="flex-grow-1">
                                        <TerrainMaterialSettings Material="@context"
                                                                 OnMaterialChanged="OnMaterialSettingsChanged"
                                                                 GeoBoundingBox="@EffectiveBoundingBox"
                                                                 TerrainSize="@_terrainSize"
                                                                 DecalRoadSettings="@(_enableDecalRoads ? _state.DecalRoadSettings : null)" />
                                    </div>
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                             Size="Size.Small"
                                             AnchorOrigin="Origin.BottomRight"
                                             TransformOrigin="Origin.TopRight">
                                        <MudMenuItem OnClick="@(() => ToggleRoadSmoothing(context))"
                                                     Icon="@(context.IsRoadMaterial ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)">
                                            @(context.IsRoadMaterial ? "Disable Road Smoothing" : "Enable Road Smoothing")
                                        </MudMenuItem>
                                        <MudDivider />
                                        <MudMenuItem OnClick="@(() => MoveToTop(context))"
                                                     Icon="@Icons.Material.Filled.VerticalAlignTop">
                                            Move to Top
                                        </MudMenuItem>
                                        <MudMenuItem OnClick="@(() => MoveToBottom(context))"
                                                     Icon="@Icons.Material.Filled.VerticalAlignBottom">
                                            Move to Bottom
                                        </MudMenuItem>
                                    </MudMenu>
                                </div>
                            </MudPaper>
                        </ItemRenderer>
                    </MudDropContainer>
                </MudPaper>

                <!-- Generate Button -->
                <MudPaper Class="pa-4 mt-4" Elevation="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <div>
                            <MudText Typo="Typo.body1">
                                <strong>Output:</strong> @GetOutputPath()
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Debug files will be saved to: @GetDebugPath()
                            </MudText>
                            @if (_analysisState.HasAnalysis)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Success">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" />
                                    Analysis cached: @_analysisState.GetSummary()
                                </MudText>
                            }
                        </div>
                        <MudStack Row="true" Spacing="2">
                            @* Analyze Settings Button *@
                            @*                             <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       Size="Size.Large"
                                       StartIcon="@Icons.Material.Filled.Analytics"
                                       OnClick="ExecuteAnalysis"
                                       Disabled="@(!CanAnalyze() || _isGenerating || _isAnalyzing)">
                                @if (_isAnalyzing)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>Analyzing...</span>
                                }
                                else
                                {
                                    <span>Analyze Settings</span>
                                }
                            </MudButton> *@

                            @* Generate Button *@
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Large"
                                       StartIcon="@Icons.Material.Filled.Build"
                                       OnClick="ExecuteTerrainGeneration"
                                       Disabled="@(!CanGenerate() || _isGenerating || _isAnalyzing)">
                                @if (_isGenerating)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>Generating...</span>
                                }
                                else
                                {
                                    <span>Generate Terrain</span>
                                }
                            </MudButton>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            }
            else if (_hasWorkingDirectory && !_isLoading && !_errors.Any())
            {
                <MudAlert Severity="Severity.Warning" Class="mt-4">
                    No terrain materials found in the selected folder.
                    Make sure the folder contains <code>art/terrains/main.materials.json</code>.
                </MudAlert>
            }

            @if (_isLoading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-4" />
                <MudText Typo="Typo.body2" Class="mt-2">Loading terrain materials...</MudText>
            }

            <!-- OSM Cache Management -->
            <OsmCacheManager Class="mt-4" />

            <MudDrawer @bind-Open="@_openDrawer"
                       Width="@_drawerWidth"
                       Height="@_drawerHeight"
                       Anchor="@_anchor"
                       Elevation="1"
                       Variant="@DrawerVariant.Temporary">
                <MudList T="string" ReadOnly="false" Dense="true" Gutters="true">
                    @{
                        var list = (_showErrorLog ? _errors : _showWarningLog ? _warnings : _messages).ToList();
                        var index = 0;
                        @foreach (var item in list)
                        {
                            <MudListItem T="string" @key="@($"{(_showErrorLog ? "e" : _showWarningLog ? "w" : "m")}_{index++}")" Style="border-bottom:1px solid grey">
                                <MudText Typo="Typo.h6">@item</MudText>
                            </MudListItem>
                        }
                    }
                </MudList>
            </MudDrawer>
        </div>

        @* Unified Footer Component *@
        <WizardFooter WizardMode="@WizardMode"
                      WizardState="@WizardState"
                      BackButtonText="@GetBackButtonText()"
                      NextButtonText="@GetNextButtonText()"
                      CanProceed="@GetCanProceed()"
                      ShowNextButton="@false"
                      ShowFinishButton="@GetShowFinishButton()"
                      ShowSkipButton="@GetShowSkipButton()"
                      OnBackClick="@OnBackClicked"
                      OnSkipClick="@SkipStep"
                      OnFinishClick="@FinishWizard">
            <SelectionInfo>
                @if (_hasWorkingDirectory)
                {
                    <MudText Typo="Typo.caption">
                        Level: @_levelName | Materials: @_terrainMaterials.Count | Size: @_terrainSize px
                    </MudText>
                }
            </SelectionInfo>
            <ActionButtons>
                @if (_errors.Any())
                {
                    <MudButton Color="Color.Error" Size="Size.Small"
                               OnClick="@(() => OpenDrawer(Anchor.Bottom, PubSubMessageType.Error))">
                        Errors (@_errors.Count)
                    </MudButton>
                }
                @if (_warnings.Any())
                {
                    <MudButton Color="Color.Warning" Size="Size.Small"
                               OnClick="@(() => OpenDrawer(Anchor.Bottom, PubSubMessageType.Warning))">
                        Warnings (@_warnings.Count)
                    </MudButton>
                }
                @if (_messages.Any())
                {
                    <MudButton Color="Color.Info" Size="Size.Small"
                               OnClick="@(() => OpenDrawer(Anchor.Bottom, PubSubMessageType.Info))">
                        Messages (@_messages.Count)
                    </MudButton>
                }
            </ActionButtons>
            <FooterLinks>
                @if (!string.IsNullOrEmpty(_workingDirectory))
                {
                    <MudButton @onclick="OpenWorkingDirectory"
                               StartIcon="@Icons.Material.Filled.FolderOpen"
                               Variant="Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Small">
                        Working Directory
                    </MudButton>
                }
            </FooterLinks>
        </WizardFooter>
    </ChildContent>
    <ErrorContent>
        <CustomErrorContent />
    </ErrorContent>
</ErrorBoundary>
</CascadingValue>

